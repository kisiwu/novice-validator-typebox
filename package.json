{
  "name": "@novice1/validator-typebox",
  "private": false,
  "version": "1.1.0",
  "description": "Typebox validator to use with @novice1/routing.",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "doc": "typedoc",
    "build": "tsdown src/**/*.ts --format cjs,esm --out-dir lib --clean --dts --sourcemap --unbundle --no-fixed-extension && node ./scripts/buildDT.mjs",
    "check": "tsc --noEmit",
    "test": "kaukau --import tsx --config kaukau-src.config.mjs",
    "test:lib": "kaukau --config kaukau-lib.config.mjs",
    "format": "cross-env NODE_OPTIONS=--experimental-strip-types prettier --write ./",
    "format:check": "cross-env NODE_OPTIONS=--experimental-strip-types prettier --check ./",
    "format:staged": "cross-env NODE_OPTIONS=--experimental-strip-types lint-staged"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kisiwu/novice-validator-typebox.git"
  },
  "keywords": [
    "express",
    "middleware",
    "typebox",
    "validator"
  ],
  "author": "demingongo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kisiwu/novice-validator-typebox/issues"
  },
  "homepage": "https://kisiwu.github.io/novice-validator-typebox/latest/",
  "dependencies": {
    "extend": "^3.0.2",
    "tslib": "^2.9.1"
  },
  "peerDependencies": {
    "@novice1/routing": "^2.2.0",
    "typebox": "^1.4.7"
  },
  "peerDependenciesMeta": {
    "@novice1/routing": {
      "optional": true
    }
  },
  "devDependencies": {
    "@novice1/routing": "^2.2.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/extend": "^3.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "chai": "^6.3.0",
    "cross-env": "^10.1.0",
    "express": "^5.3.0",
    "kaukau": "^6.0.2",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.16",
    "typescript": "^5.9.3"
  }
}